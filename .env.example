# ---------------------------------------------------------------------------
# Public origin
# ---------------------------------------------------------------------------
# Canonical origin of the deployed site. The server builds every outbound URL
# (Lemon Squeezy checkout redirects above all) from this value, so it must be
# the real domain in production - never a preview/AI Studio host.
APP_URL=https://talentfabric.eu
VITE_APP_URL=https://talentfabric.eu

# ---------------------------------------------------------------------------
# Lemon Squeezy (server-side secrets - never expose with a VITE_ prefix)
# ---------------------------------------------------------------------------
# Test keys start with "ls_t_", live keys do not. While the store is still
# pending Merchant-of-Record activation, ONLY test keys work: live keys return
# 401 Unauthorized and the store returns 403 Forbidden.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Optional override. Left empty, test mode is inferred from the API key prefix
# (ls_t_ -> test). Set to true/false to force it.
LEMON_SQUEEZY_TEST_MODE=

# ---------------------------------------------------------------------------
# Product variant IDs (client-side access)
# ---------------------------------------------------------------------------
# Use the VARIANT id, not the product id. Test-mode and live-mode products have
# different variant ids, so these must be swapped when switching environments.
VITE_LEMON_SQUEEZY_PRO_PLAN_VARIANT_ID=
VITE_LEMON_SQUEEZY_FEATURED_BOOST_VARIANT_ID=
VITE_LEMON_SQUEEZY_SINGLE_JOB_VARIANT_ID=

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# /api/debug-config and /api/test-lemon-connection are open in development. In
# production they are hidden unless this token is set and sent as x-debug-token.
DEBUG_TOKEN=
