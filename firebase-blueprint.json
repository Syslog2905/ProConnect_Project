{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores professional profile data and GDPR settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "headline": { "type": "string" },
        "bio": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "role": { "type": "string", "enum": ["professional", "recruiter", "employer", "admin"] },
        "visibility": { "type": "string", "enum": ["active", "passive", "hidden"] },
        "gdprConsent": { "type": "boolean" },
        "consentDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "linkedinURL": { "type": "string", "format": "uri" }
      },
      "required": ["uid", "email", "role", "gdprConsent"]
    },
    "Connection": {
      "title": "Connection",
      "description": "Represents a networking connection or request.",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string" },
        "toUid": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromUid", "toUid", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "Secure message between users.",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string" },
        "receiverUid": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "receiverUid", "content"]
    },
    "JobPost": {
      "title": "Job Post",
      "description": "A job listing posted by a recruiter.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recruiterUid": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "salaryRange": { "type": "string" },
        "type": { "type": "string", "enum": ["full-time", "part-time", "contract", "freelance"] },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "isFeatured": { "type": "boolean" }
      },
      "required": ["id", "recruiterUid", "title", "company", "location", "description", "type", "status", "createdAt"]
    },
    "EmployerInsight": {
      "title": "Employer Insight",
      "description": "Cached insights for a company.",
      "type": "object",
      "properties": {
        "query": { "type": "string" },
        "summary": { "type": "string" },
        "sources": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "uri": { "type": "string" },
              "title": { "type": "string" }
            }
          }
        },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["query", "summary", "lastUpdated"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/connections/{connectionId}": {
      "schema": "Connection",
      "description": "Networking connections."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Direct messages."
    },
    "/jobs/{jobId}": {
      "schema": "JobPost",
      "description": "Job listings."
    },
    "/employer_insights/{companyId}": {
      "schema": "EmployerInsight",
      "description": "Cached employer insights."
    }
  }
}
